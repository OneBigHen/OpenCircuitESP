# Save as .env; share with firmware/include/secrets.h but DO NOT commit either.
RING_TOKEN=CHANGE_ME_TO_A_RANDOM_32_BYTE_SECRET
# Optional separate, read-only dashboard access key (otherwise RING_TOKEN).
RING_VIEW_TOKEN=
# Default: HTTPS-only browser cookies. Set 0 ONLY for deliberate LAN HTTP use.
RING_SECURE_COOKIE=1
