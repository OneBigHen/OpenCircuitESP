#pragma once
// Copy to secrets.h, edit locally; NEVER commit the finished file.
#define WIFI_SSID "CHANGE_ME"
#define WIFI_PASSWORD "CHANGE_ME"
#define COLLECTOR_URL "http://192.168.1.40:8765"
#define COLLECTOR_TOKEN "CHANGE_TO_A_RANDOM_32_BYTE_SECRET"
// Set exact name from USB serial scan; do NOT set to a generic "RingConn".
#define RING_NAME "RingConn Gen2-XXXX"
// Optional additional protection, uppercase MAC from System ID; blank = name-only.
#define RING_MAC ""
#define LOCAL_TIMEZONE "EST5EDT,M3.2.0,M11.1.0"
#define SYNC_START_HOUR 9
#define SYNC_END_HOUR 22
// Sleep window: no history drains in here (sleep history stays on the ring and is drained once
// after waking, as the OpenCircuit iOS app does). Defaults 23 and 8 if unset.
#define SLEEP_START_HOUR 23
#define SLEEP_END_HOUR 8
#define SYNC_INTERVAL_SECONDS (8UL * 3600UL)
// Optional second collector (e.g. a new host during migration, or a standby). The bridge uses the
// primary, and switches to this one whenever the active collector stops answering, and back again.
// #define COLLECTOR_URL_FALLBACK "http://192.168.1.175:8765"
